#!/usr/bin/env bash
set -euo pipefail

repo_root="$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")/.." && pwd -P)"
config_path="$repo_root/config/homemaster.yaml"
python_path="$repo_root/.runtime/venv/bin/python"

if [[ ! -f "$config_path" ]]; then
  printf 'HomeMaster config is missing: %s\nRun: cp config/homemaster.example.yaml config/homemaster.yaml\n' "$config_path" >&2
  exit 2
fi
if [[ ! -x "$python_path" ]]; then
  printf 'HomeMaster runtime is not initialized: %s\nRun scripts/setup_memory_runtime.py setup ... once on this server.\n' "$python_path" >&2
  exit 2
fi

command_name="${1:-}"
if [[ "$command_name" == "benchmark-alfworld" || "$command_name" == "benchmark-alfworld-taskset" ]]; then
  formal_python="$python_path"
  python_path="$repo_root/.runtime/alfworld-venv/bin/python"
  if [[ ! -x "$python_path" ]]; then
    printf 'ALFWorld runtime is not initialized: %s\nRun setup with --alfworld-python ... once on this server.\n' "$python_path" >&2
    exit 2
  fi
  if [[ ! -f "$repo_root/.runtime/alfworld/configs/base_config.yaml" || \
        ! -d "$repo_root/.runtime/alfworld/data/json_2.1.1" ]]; then
    printf 'ALFWorld root is not initialized: %s\nRun setup with --alfworld-python and --alfworld-root once on this server.\n' "$repo_root/.runtime/alfworld" >&2
    exit 2
  fi
  formal_site="$($formal_python -c 'import site; print(site.getsitepackages()[0])')"
  if ! mindmemos_source="$($formal_python -c 'from pathlib import Path; import mindmemos; print(Path(mindmemos.__file__).resolve().parent.parent)')"; then
    printf 'Formal HomeMaster runtime cannot resolve MindMemOS. Run uv sync in the project environment.\n' >&2
    exit 2
  fi
  if [[ ! -d "$mindmemos_source" ]]; then
    printf 'Formal HomeMaster MindMemOS source is missing: %s\n' "$mindmemos_source" >&2
    exit 2
  fi
  export PYTHONPATH="$repo_root/src:$formal_site:$mindmemos_source${PYTHONPATH:+:$PYTHONPATH}"
  if ! "$python_path" -c 'import alfworld, ai2thor, homemaster, mindmemos' >/dev/null; then
    printf 'ALFWorld runtime cannot import the complete HomeMaster benchmark dependency closure.\n' >&2
    exit 2
  fi
fi

export HOMEMASTER_CONFIG_PATH="$config_path"
export PYTHONPATH="${PYTHONPATH:-$repo_root/src}"
cd "$repo_root"

if [[ "${HOMEMASTER_SKIP_RUNTIME_CHECK:-0}" != "1" ]]; then
  "$python_path" "$repo_root/scripts/setup_memory_runtime.py" check \
    --repo-root "$repo_root" --config "$config_path" >/dev/null
fi

exec "$python_path" -m homemaster.cli "$@"
